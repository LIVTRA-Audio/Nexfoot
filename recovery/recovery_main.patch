+/*
+ * NEXFOOT MD400 recovery boot policy.
+ *
+ * PP0 drives the board's PWR_CTL latch.  PB1 is the active-high ON/OFF key.
+ * With the PA0 USB_CHECK input high, holding PB1 for two seconds at boot
+ * enters the existing BD19 mask UBOOT USB updater.  A broken JLFS or failed
+ * app jump also enters UBOOT without depending on the key.
+ */
+#define MD400_POWER_LATCH_PORT          IO_PORTP_00
+#define MD400_POWER_KEY_PORT            IO_PORTB_01
+#define MD400_USB_CHECK_PORT            IO_PORTA_00
+#define MD400_RECOVERY_HOLD_MS           2000
+#define MD400_RECOVERY_POLL_MS           10
+#define MD400_UPGRADE_USB_SOFT_KEY       2
+#define MD400_MASK_SOFT_FLAG_ADDR        0x001a1830u
+#define MD400_MASK_SOFT_FLAG_VALID       BIT(6)
+#define MD400_SOFTFLAG_OUT1              7
+
+extern void nvram_set_boot_state(u32 state);
+
+static void md400_power_latch_hold(void)
+{
+    gpio_set_pull_up(MD400_POWER_LATCH_PORT, 0);
+    gpio_set_pull_down(MD400_POWER_LATCH_PORT, 0);
+    gpio_set_die(MD400_POWER_LATCH_PORT, 1);
+    gpio_write(MD400_POWER_LATCH_PORT, 1);
+    gpio_set_direction(MD400_POWER_LATCH_PORT, 0);
+}
+
+static void md400_power_key_init(void)
+{
+    gpio_set_pull_up(MD400_POWER_KEY_PORT, 0);
+    gpio_set_pull_down(MD400_POWER_KEY_PORT, 0);
+    gpio_set_die(MD400_POWER_KEY_PORT, 1);
+    gpio_set_direction(MD400_POWER_KEY_PORT, 1);
+}
+
+static void md400_usb_check_init(void)
+{
+    gpio_set_pull_up(MD400_USB_CHECK_PORT, 0);
+    gpio_set_pull_down(MD400_USB_CHECK_PORT, 1);
+    gpio_set_die(MD400_USB_CHECK_PORT, 1);
+    gpio_set_direction(MD400_USB_CHECK_PORT, 1);
+}
+
+static u8 md400_usb_cable_present(void)
+{
+    return gpio_read(MD400_USB_CHECK_PORT) ? 1 : 0;
+}
+
+static u8 md400_recovery_key_held(void)
+{
+    u32 held_ms = 0;
+
+    if (!md400_usb_cable_present() || !gpio_read(MD400_POWER_KEY_PORT)) {
+        return 0;
+    }
+
+    while (held_ms < MD400_RECOVERY_HOLD_MS) {
+        mdelay(MD400_RECOVERY_POLL_MS);
+        if (!md400_usb_cable_present() || !gpio_read(MD400_POWER_KEY_PORT)) {
+            return 0;
+        }
+        held_ms += MD400_RECOVERY_POLL_MS;
+    }
+    return 1;
+}
+
+static void md400_mask_keep_power_latch(void)
+{
+    volatile u8 *soft_flag = (volatile u8 *)MD400_MASK_SOFT_FLAG_ADDR;
+    u8 flag0 = (JL_IOMAP->CON0 & BIT(16)) ? BIT(2) : 0;
+
+    /* Exact BD19 mask NVRAM layout used by SDK mask_softflag_config(). */
+    soft_flag[0] |= MD400_MASK_SOFT_FLAG_VALID;
+    soft_flag[8] = flag0;
+    soft_flag[9] = MD400_SOFTFLAG_OUT1 << 5;
+    soft_flag[26] = 0;
+    soft_flag[27] = 0;
+}
+
+__attribute__((noreturn))
+static void md400_enter_mask_uboot(const char *reason)
+{
+    log_info("NEXFOOT recovery: %s\n", reason);
+    md400_power_latch_hold();
+    md400_mask_keep_power_latch();
+    nvram_set_boot_state(MD400_UPGRADE_USB_SOFT_KEY);
+    chip_reset();
+    while (1) {
+        asm("nop");
+    }
+}
+
